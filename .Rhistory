Dual_inoculation <- read_csv(here("Phenotype", "Data_input", "Dual_inoculation.csv"))
#View(Dual_inocualtion)
Dual_inoculation <- Dual_inoculation %>%
mutate(Colonies_Dry = as.numeric(Colonies_Dry)) %>%
mutate(Colonies_Mucoid = as.numeric(Colonies_Mucoid))
Dual_inoculation_initial <- Dual_inoculation %>% filter(Growth_Chamber == "Initial")
#View(Dual_inoculation_initial)
colnames(Dual_inoculation_initial)
#View(Dual_inoculation_initial)
Dual_inoculation_initial_ave <- Dual_inoculation_initial %>%
group_by(Name, Morphology) %>%
summarise(
colonies_ave = case_when(
first(Morphology) == "Dry"    ~ mean(Colonies_Dry, na.rm = TRUE),
first(Morphology) == "Mucoid" ~ mean(Colonies_Mucoid, na.rm = TRUE),
TRUE ~ NA_real_
),
.groups = "drop"
)
Dual_inoculation_initial_ave
### I will build the proportion within each pair. These are the pairs; 91 - 101, 015 - 099, 016 - 100, and 029 - 098,
pair_map <- tibble::tribble(
~Name, ~Pairs,
"015", "015_099",
"099", "015_099",
"029", "029_098",
"098", "029_098",
"016", "016_100",
"100", "016_100",
"091", "091_101",
"101", "091_101"
)
Dual_inoculation_initial_pct <- Dual_inoculation_initial_ave %>%
left_join(pair_map, by = "Name") %>%
dplyr::select(Pairs, Morphology, colonies_ave) %>%
pivot_wider(names_from = Morphology, values_from = colonies_ave) %>%
mutate(`Percentage of Dry bacteria` = Dry / (Dry + Mucoid) * 100)
Dual_inoculation_initial_pct <- Dual_inoculation_initial_pct %>%
rename(Name = Pairs, Percentage_Dry_initial = `Percentage of Dry bacteria`)
Harvesting_results_RPM <- Dual_inoculation  %>% filter(!Morphology %in% c("Control", "Initial")) # Remove control and NA cells
Harvesting_results_RPM <- Harvesting_results_RPM %>%
mutate(Colonies_Dry = as.numeric(Colonies_Dry)) %>%
mutate(Colonies_Mucoid = as.numeric(Colonies_Mucoid)) %>%
mutate(Percentage_Dry = (Colonies_Dry/(Colonies_Dry + Colonies_Mucoid)*100)) #One plate per plant
#View(Harvesting_results_RPM)
Harvesting_results_Dual <- Harvesting_results_RPM %>% filter(Morphology == "Dual")
#View(Harvesting_results_Dual)
Harvesting_results_Dual
Dual_Competition <- ggplot(Harvesting_results_Dual, aes(x = Name, y = Percentage_Dry)) +
stat_boxplot(geom = "errorbar", width = 0.3, color = "black", position = position_dodge(width = 0.8)) +
geom_boxplot(outlier.shape = NA, position = position_dodge(width = 0.8), fill = "#e0ba3e") +
geom_jitter(position = position_jitterdodge(jitter.width = 0.15, dodge.width = 0.8), size = 2, color = "black") +
geom_crossbar(
data = Dual_inoculation_initial_pct,
aes(x = Name, y = Percentage_Dry_initial,
ymin = Percentage_Dry_initial, ymax = Percentage_Dry_initial,
color = "Initial"),
inherit.aes = FALSE,
width = 0.6,
linewidth = 1
) +
scale_color_manual(name = NULL, values = c("Initial" = "red")) +
labs(x = "Pairs", y = "Percentage of dry bacteria") +
theme_classic() +
theme(
text             = element_text(family = "Helvetica", color = "black"),
axis.text        = element_text(size = 14, color = "black"),
axis.title.x     = element_text(size = 18, color = "black"),
axis.title.y     = element_text(size = 18, color = "black"),
panel.grid       = element_blank(),
axis.line        = element_line(color = "black"),
axis.ticks       = element_line(color = "black")
)
Dual_Competition
ggsave(Dual_Competition,
