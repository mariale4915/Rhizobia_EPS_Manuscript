tree<-read.tree(here("Genotype", "Data_input", "AVT_single_copy_core_concat.fasta.treefile")) ### I am using this file but Sohini still hasn't told me how this file was created (whether it is rooted or not, this is the same tree that was used for Liz's paper)
tree
## Extract the strains in the tree which represents what Sohini used.
tip_strains <- data.frame(Strain_Code = tree$tip.label) #I am using the Strain_Code name to match the column name for that type of naming system in Strains_Description_Phenotype_Github.xlsx
