### Survival ###
Survival_Mesocosm <- read_excel("/Users/mariaalejandragilpolo/OneDrive - The Pennsylvania State University/Burghardt Lab Shared Folder/Projects/NIFA-AVT-AlfalfaProjects/Aim1bAVT_StrainCollection/Chapter1_Partners_Mariale/Experiments/Mesocosms/Mesocosm_survival/Data_input_Mesocosm_survival.xlsx", sheet=2)
Survival_Mesocosm <- Survival_Mesocosm %>% filter(!is.na(Volume_ul)) #Filtering out the ones that were not assessed
Survival_Mesocosm <- Survival_Mesocosm %>% filter(Rep_tube != "s") #Filtering out the "sacrificed" plants that I counted to assess what dilutions should I plate
Survival_Mesocosm$Colonies_Dry <- as.numeric(Survival_Mesocosm$Colonies_Dry)
Survival_Mesocosm$Colonies_Mucoid <- as.numeric(Survival_Mesocosm$Colonies_Mucoid)
Survival_Mesocosm$Dilution <- as.numeric(Survival_Mesocosm$Dilution)
Survival_Mesocosm$Volume_ul <- as.numeric(Survival_Mesocosm$Volume_ul)
Survival_Mesocosm <- Survival_Mesocosm %>%
mutate(
Dry_CFU_Total = Colonies_Dry*10^5*10^(Dilution -1)/Volume_ul,
Mucoid_CFU_Total = Colonies_Mucoid*10^5*10^(Dilution -1)/Volume_ul,
Total_CFU = Dry_CFU_Total + Mucoid_CFU_Total,
Percentage_Dry = Dry_CFU_Total*100/Total_CFU
)
#View(Growth_mesocosm)
Survival_Mesocoms_ave <- Survival_Mesocosm %>%
group_by(Name, Treatment, Morphology, Timepoint, Rep_tube) %>%
summarise(
Dry_CFU_Total_ave   = mean(Dry_CFU_Total,   na.rm = TRUE),
Mucoid_CFU_Total_ave = mean(Mucoid_CFU_Total, na.rm = TRUE),
Total_CFU_ave       = mean(Total_CFU,       na.rm = TRUE),
Percentage_Dry_ave  = mean(Percentage_Dry,  na.rm = TRUE),
.groups = "drop"
)
### Growth ###
Growth_Mesocosm <- read_excel("/Users/mariaalejandragilpolo/OneDrive - The Pennsylvania State University/Burghardt Lab Shared Folder/Projects/NIFA-AVT-AlfalfaProjects/Aim1bAVT_StrainCollection/Chapter1_Partners_Mariale/Experiments/Mesocosms/Mesocosm_growth/Data_input_Mesocosms_growth.xlsx", sheet=1)
#View(Growth_mesocosm)
Growth_Mesocosm$Colonies_Dry <- as.numeric(Growth_Mesocosm$Colonies_Dry)
Growth_Mesocosm$Colonies_Mucoid <- as.numeric(Growth_Mesocosm$Colonies_Mucoid)
Growth_Mesocosm$Dilution <- as.numeric(Growth_Mesocosm$Dilution)
Growth_Mesocosm$Volume_ul <- as.numeric(Growth_Mesocosm$Volume_ul)
Growth_Mesocosm <- Growth_Mesocosm %>%
mutate(
Dry_CFU_Total = Colonies_Dry*10^5*10^(Dilution -1)/Volume_ul,
Mucoid_CFU_Total = Colonies_Mucoid*10^5*10^(Dilution -1)/Volume_ul,
Total_CFU = Dry_CFU_Total + Mucoid_CFU_Total,
Percentage_Dry = Dry_CFU_Total*100/Total_CFU
)
Growth_Mesocoms_ave <- Growth_Mesocosm %>%
group_by(Name, Treatment, Morphology, Timepoint, Rep_tube) %>%
summarise(
Dry_CFU_Total_ave   = mean(Dry_CFU_Total,   na.rm = TRUE),
Mucoid_CFU_Total_ave = mean(Mucoid_CFU_Total, na.rm = TRUE),
Total_CFU_ave       = mean(Total_CFU,       na.rm = TRUE),
Percentage_Dry_ave  = mean(Percentage_Dry,  na.rm = TRUE),
.groups = "drop"
)
#View(Growth_Mesocoms_ave)
## I will give different shapes to timepoints and colors to treatments.
myshapes_survival<-data.frame(Timepoint=c("3months","6months","1year"),shapes=c(16, 5, 12))
myshapes_survival$Timepoint <- factor(myshapes_survival$Timepoint, ordered = TRUE)
myshapes_survival <- setNames(myshapes_survival$shapes, myshapes_survival$Timepoint)
myshapes_growth<-data.frame(Timepoint= c("7", "14", "21", "42"),shapes=c(1, 2, 3, 4))
myshapes_growth$Timepoint <- factor(myshapes_growth$Timepoint, ordered = TRUE)
myshapes_growth <- setNames(myshapes_growth$shapes, myshapes_growth$Timepoint)
mycols<-data.frame(Treatment=c("22", "32","4", "Drought"), cols=c("#999999","#D55E00", "#882255", "#56B4E9"))
mycols$Treatment <- factor(mycols$Treatment, ordered=TRUE)
mycols <- setNames(mycols$cols, mycols$Treatment)
#### Survival Mucoid
Survival_Mesocoms_Mucoid_ave <- Survival_Mesocoms_ave %>% filter(Morphology == "Mucoid") ## Extracting the values for mucoid
Survival_Mesocoms_Mucoid_ave_NoInitial <- Survival_Mesocoms_Mucoid_ave %>% filter(Timepoint != "0") ## Filtering out the initial values
### I need to put the same initial values to all the treatments because the all started with the same numbers, including drought although the inoculation was done with 0.5ml of a more concentrated inoculum based on the calculations I did with the growth experiments.
initial_baseline_mucoid <- Survival_Mesocoms_Mucoid_ave %>% filter(Timepoint == "0") ## Extract Timepoint "0"
## Treatments that need that "0" data added
treatments_to_add_mucoid <- Survival_Mesocoms_Mucoid_ave_NoInitial %>% ## I will put it to the treatments that do not include the initial treatment
distinct(Treatment) %>%
pull(Treatment)
treatments_to_add_mucoid <- unique(treatments_to_add_mucoid)
baseline_rows <- purrr::map_dfr( ### This code adds the values in "0" timepoint to all of the treatments.
treatments_to_add_mucoid,
~ initial_baseline_mucoid %>%
mutate(Treatment = .x, Timepoint = "0")
)
baseline_rows
## Integrate the 0wk data with the initial file
Survival_Mesocoms_Mucoid_ave.expanded <- bind_rows(baseline_rows, Survival_Mesocoms_Mucoid_ave_NoInitial)
Survival_Mesocoms_Mucoid_ave.expanded$Log10Total <- log10(Survival_Mesocoms_Mucoid_ave.expanded$Total_CFU_ave) #Calculate the log10 of the population size
### Survival Dry
Survival_Mesocoms_Dry_ave <- Survival_Mesocoms_ave %>% filter(Morphology == "Dry") ## Filter out the Dry mesocosm
Survival_Mesocoms_Dry_NoInitial_ave <- Survival_Mesocoms_Dry_ave %>% filter(Timepoint != "0") #Extract the initial values
initial_baseline_Dry <- Survival_Mesocoms_Dry_ave %>% filter(Timepoint == "0")
treatments_to_add_Dry <- Survival_Mesocoms_Dry_NoDrought_ave %>%
distinct(Treatment) %>%
pull(Treatment)
