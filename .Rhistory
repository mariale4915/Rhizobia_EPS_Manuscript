library(performance)
library(lmerTest)
library(ggbeeswarm)
#library(glmmTMB)
library(here)
library(ggplot2)
library(readxl)
library(dplyr)
library(writexl)
library(tidyverse)
library(remotes)
library(ggridges)
library(scales)
library(broom)
library(vcfR)
library(adegenet)
library(car)
library(multcomp)
#citation("car")
#citation("multcomp")
#citation("lmerTest")
#citation("vcfR")
## What R version am I using##
R.version.string
color_values <- c("Mucoid" = "#4eadb9",
"Dry" = "#e0ba3e",
"Mixture" = "#97b47c")
set.seed(123)
vcf <- read.vcfR(here("Genotype", "Data_input", "strain_118_variants.vcf"))
gt_reference <- extract.gt(vcf, element = "GT") ## 0 and 1
#gt_reference
gt_numeric <- apply(gt_reference, 2, as.numeric) #"2" tells R to look at the data by columns, and "as.numeric" changes the text to other values into numbers
#gt_numeric
rownames(gt_numeric) <- rownames(gt_reference) #Putting the names back
#gt_numeric
## PCA needs one row per strain (observation), one column per SNP (variable). The current matrix is the other way around, so I will transpose it.
gt_matrix <- t(gt_numeric)
#head(gt_matrix)
dim(gt_matrix) ## It shows 117 and 136566 #
sum(is.na(gt_matrix)) #there are 762479 missing values ## handle the NAs because prcomp() can not handle NAs
complete_snps <- colSums(is.na(gt_matrix)) == 0 ## Returns TRUE for columns that have zero missing values, this is a way to filter and keep only the complete columns
#complete_snps
gt_matrix <- gt_matrix[,complete_snps] ## Here I am retaining only the columns that do not have any missing data.
dim(gt_matrix) # 117 and 96206
### Run the PCA ###
pca_result <- prcomp(gt_matrix, center = TRUE, scale. = FALSE)
pca_summary <- summary(pca_result)$importance
pca_summary
round(pca_summary["Proportion of Variance", ]*100,2)[1]
pca_table <- data.frame(
PC = colnames(pca_summary),
Percent_Variance = round(pca_summary["Proportion of Variance", ] * 100, 2))
pca_table
pca_table_top10 <- pca_table %>% #The proportion of varance is the same than pca_result$sdev^2, and then (pc_variance/sum(pc_variance))*100
slice_max(order_by = Percent_Variance, n = 10)
pca_table_top10
write_xlsx(pca_table_top10, here("Phenotype", "Tables", "EPS_TableS1_FromR.xlsx"))
pca_table_top10$PC <- factor(pca_table_top10$PC, levels = c("PC1", "PC2", "PC3", "PC4", "PC5", "PC6", "PC7", "PC8", "PC9", "PC10"))
#scree_data #
screeplot <- ggplot(pca_table_top10, aes(x = PC, y = Percent_Variance)) +
geom_bar(stat = "identity", fill = "steelblue", alpha = 0.8) +   # Draw the background bars
scale_y_continuous(limits = c(0, 100), breaks = seq(0, 100, 20), expand = c(0, 0)) +
labs(
title = "PCA Scree Plot with only the first 10 PCs",
x = "Principal Component",
y = "Variance Explained (%)"
) +
theme_classic()
screeplot
ggsave(here("Phenotype", "Figures", "EPS_FigureS1A_FromR.pdf"), screeplot, width = 4, height = 2.5, units = "in")
# Get the pc_scores
## I will use the pc_scores
pc_scores <- as.data.frame(pca_result$x)
pc_scores <- rownames_to_column(pc_scores, var = "Strain_Code")
pc_scores #PC1 and PC2 will be incorporated as fixed-effect variables in statistical models that indicate this
### I will merge this data with the morphology data to be able to color them based on "Morphology"
Strains <- read_excel(here("Genotype", "Data_input", "Strains_Description_Phenotype_Github.xlsx"))
Strains
### Merge
Strain_morphotype <- merge(Strains, pc_scores, by = "Strain_Code")
Strain_morphotype
### This file cointains the information about the phylogenetically relatedness, I will store it
write_csv(Strain_morphotype, here("Phenotype", "Tables", "PCA_scores_strains.csv"))
## Plot
var_explained <- (pca_result$sdev^2) / sum(pca_result$sdev^2)
var_explained
PCA <- ggplot(merge(Strains, pc_scores, by = "Strain_Code"), aes(x = PC1, y = PC2, color = Morphology)) +
geom_point(size = 2) +
scale_color_manual(values = c("Mucoid" = "#4eadb9",
"Dry" = "#e0ba3e")) +
xlab(paste0("PC1 (", round(pca_summary["Proportion of Variance", ]*100,2)[1], "%)")) + #42.6
ylab(paste0("PC2 (", round(pca_summary["Proportion of Variance", ]*100,2)[2], "%)")) + #17.6
theme_bw()
PCA
ggsave(plot = PCA, here("Phenotype", "Figures", "EPS_FigureS1B_FromR.pdf"),
width = 6, height = 2.5, units = "in")
Individual_nodule_data <- read.csv(here("Phenotype", "Data_input", "SingleNodule_Ocurrence_data.csv"))
#View(Individual_nodule_data)
Individual_nodule_data <- Individual_nodule_data %>% filter(Morphology %in% c("Dry", "Mucoid", "Mixture")) #Remove contaminants and morphologies that did not have a clear morphology. The percentages are therefore calculated with respect of the total nodules where we could extract data
Individual_nodule_data
### Create a table that shows the proportions of each morphology in the nodules
function_pair <- function(Partner) {c(
Name = Partner,
nrow(Individual_nodule_data %>% filter(Name == Partner)),
sprintf("%.3f", 100*nrow(Individual_nodule_data %>% filter(Name == Partner & Morphology == "Mucoid"))/nrow(Individual_nodule_data %>% filter(Name == Partner))),
sprintf("%.3f", 100*nrow(Individual_nodule_data %>% filter(Name == Partner & Morphology == "Dry"))/nrow(Individual_nodule_data %>% filter(Name == Partner))),
sprintf("%.3f", 100*nrow(Individual_nodule_data %>% filter(Name == Partner & Morphology == "Mixture"))/nrow(Individual_nodule_data %>% filter(Name == Partner))))
}
#Pair 091_101
function_pair("091_101")
Table_mix_percentage <- rbind(function_pair("091_101"), function_pair("015_099"), function_pair("016_100"), function_pair("029_098"))
Table_mix_percentage <- as.data.frame(Table_mix_percentage)
Table_mix_percentage
colnames(Table_mix_percentage) <- c("Pair", "Number of nodules", "% Mucoid", "% Dry", "% Mixture")
Table_mix_percentage
write_xlsx(Table_mix_percentage, here("Phenotype" , "Tables", "EPS_TableS2_FromR.xlsx"))
