Morphology_Root_boxplots <- ggplot(data = MasterSpreadsheet_AVT_Single_strain_exp_summary, aes(x= Morphology, y = ave_root, fill = Morphology)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter() +
scale_fill_manual(values = color_initial_values) +
facet_wrap(~Variety) +
theme_classic() +
labs(
x= "Morphology",
y = "Root biomass (g)"
) +
theme(legend.position = "none")
Morphology_Root_boxplots
ggsave("Morphology_Root_boxplots_FromR.pdf", Morphology_Root_boxplots, width = 5, height = 3, units = "in")
## Merge shoot biomass and EPS production ##
Shoot_OD <- merge(MasterSpreadsheet_AVT_Single_strain_exp_summary, Anthrone, by = "Strain")
## Select only importanta columns
#View(Shoot_OD)
Shoot_OD <- Shoot_OD %>% select(Strain, Variety, Glucose_OD600, ave_shoot)
#View(Shoot_OD)
#View(StrainFitness_Plant_ave)
Shoot_fitness_OD <- merge(Shoot_OD, StrainFitness_Plant_ave, by = c("Strain","Variety"))
#View(Shoot_fitness_OD)
## Merge with fitness data as well
## Find the average of the glucose
Shoot_fitness_OD_ave <- Shoot_fitness_OD %>%
group_by(Strain, Variety, ave_shoot, Morphology, Fitness_ave) %>%
summarise(Glucose_OD600_ave = mean(Glucose_OD600))
View(Shoot_fitness_OD_ave)
### Filter out 121
Shoot_fitness_OD_ave <- Shoot_fitness_OD_ave %>% filter(Strain != "121")
color_initial_values <- c("Dry" = "#e0ba3e",
"Mucoid" = "#4eadb9")
### Shoot biomass jitter
Anthrone_PlantBiomass <- ggplot(data = Shoot_fitness_OD_ave, aes(x= Glucose_OD600_ave, y = ave_shoot, color = Morphology)) +
geom_jitter() +
geom_smooth(method = "lm",
se = FALSE,
color = "grey") +
scale_color_manual(values = color_initial_values) +
facet_wrap(~Variety) +
theme_classic() +
labs(
x= "Glucose/OD600",
y = "Plant shoot biomass (g)"
)
Anthrone_PlantBiomass
ggsave("Anthrone_PlantBiomass_FromR_withoutlier.pdf", Anthrone_PlantBiomass, width = 9, height = 4, units = "in")
