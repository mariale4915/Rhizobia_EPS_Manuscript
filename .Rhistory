colnames(Single_nodule_CFU_clean)
#View(Single_nodule_CFU_clean)
model_intercept <- lmer(log10(Density) ~ Morphology*Variety + (1 | Strain) + (1 | Strain:Plant_Rep),  data = Single_nodule_CFU_clean)
model_intercept
anova(model_intercept, type = 3)
