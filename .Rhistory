aes(x = Timepoint, y = median,
color = Treatment,
linetype = Population_Morphology,
group = interaction(Treatment, Population_Morphology))) +
geom_point() +
geom_line(size = 1) +
geom_errorbar(aes(ymin = min, ymax = max), width = 0.05) +
scale_color_manual(values = mycols) +
scale_linetype_manual(values = c("Mixture" = "dotted")) +
xlab("Timepoint") +
ylab("Log10(CFU/mesocosm)") +
#  scale_y_log10() +
coord_cartesian(ylim = c(3, 10)) +
#  facet_wrap(~Condition,  scales = "free_x") +
theme_minimal(base_size = 12) +
theme(
text = element_text(family = "Helvetica", color = "black"),
axis.text = element_text(size = 14, color = "black"),
axis.title.x = element_text(size = 18),
axis.title.y = element_text(size = 18),
panel.grid = element_blank(),
axis.line = element_line(color = "black"),
axis.ticks = element_line(color = "black"),
legend.position = "none"
)
Survival_Mixture <- ggplot(popsize_tube %>% filter(Condition == "Survival", Population_Morphology == "Mixture"),
aes(x = Timepoint, y = median,
color = Treatment,
linetype = Population_Morphology,
group = interaction(Treatment, Population_Morphology))) +
geom_point() +
geom_line(size = 1) +
geom_errorbar(aes(ymin = min, ymax = max), width = 0.05) +
scale_color_manual(values = mycols) +
scale_linetype_manual(values = c("Mixture" = "dotted")) +
xlab("Timepoint") +
ylab("Log10(CFU/mesocosm)") +
#  scale_y_log10() +
coord_cartesian(ylim = c(3, 10)) +
#  facet_wrap(~Condition,  scales = "free_x") +
theme_minimal(base_size = 12) +
theme(
text = element_text(family = "helvetica", color = "black"),
axis.text = element_text(size = 14, color = "black"),
axis.title.x = element_text(size = 18),
axis.title.y = element_text(size = 18),
panel.grid = element_blank(),
axis.line = element_line(color = "black"),
axis.ticks = element_line(color = "black"),
legend.position = "none"
)
## Plot
#View(Individual_nodule_data)
coocurrence <- ggplot(Individual_nodule_data,
aes(x = Name, fill = Morphology)) +
geom_bar(position = "fill") +
scale_fill_manual(values = color_values)+
scale_y_continuous(labels = scales::percent) +
labs(x = "Pair", y = "Percentage")+
theme_classic() +
theme(
text             = element_text(family = "helvetica", color = "black"),
axis.text        = element_text(size = 14, color = "black"),
axis.title.x     = element_text(size = 18, color = "black"),
axis.title.y     = element_text(size = 18, color = "black"),
panel.grid.minor       = element_blank(),
panel.grid.major = element_blank(),
axis.line        = element_line(color = "black"),
axis.ticks       = element_line(color = "black"))
coocurrence
ggsave(coocurrence,
filename = here("Phenotype", "Figures" ,"EPS_FigureS2B_FromR.pdf"),
device = "pdf",
height = 4, width = 6, units = "in")
