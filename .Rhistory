random_effects_rows <- data.frame(
Term = c("Random effect: Pairs (variance)",
"Random effect: Pairs (LRT vs. no random effect)"),
Estimate = c(sprintf("%.3f", pairs_variance), "-"),
`Std. Error` = c("-", "-"),
df = c("-", sprintf("%.0f", lrt_row$Df)),
t_value = c("-", sprintf("%.3f (\u03c7\u00b2)", lrt_row$LRT)),
p_value = c("-", ifelse(lrt_row$`Pr(>Chisq)` < 0.001, "< 0.001",
sprintf("%.3f", lrt_row$`Pr(>Chisq)`))),
check.names = FALSE
)
full_table <- bind_rows(fixed_effects, random_effects_rows)
