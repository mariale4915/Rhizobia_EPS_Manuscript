Host_data <-  read.csv(here("Data_input", "Single_Strain_Experiment_Host.csv"))
#View(Host_data)
## I will remove the plants that are dead
Host_data <- Host_data %>% filter(!NOTES %in% c("DEAD", "DEAD - No root or shoot envelope found")) #Ask Liana, there are other notes like "2 plants in the root envelope", "help with label" and other random stuff that I am not sure if it is appropriate. I can always just delete that when I cure the data, but I don't know if some of those warnings should be taken seriously to the point that entire rows are removed.
#View(Host_data)
## I will remove the commercial inoculants
Host_data <- Host_data %>% filter(!Strain %in% c("UNI", "NIG", "MIX", "MC2", "EXC"))
## Data I am interested in: Shoot biomass (Shootweight_g), total nodule number (I have to add the nodules), and the proportion of nodule branched
Host_data <- Host_data %>% select(Strain, Variety, Rep, Label, Rootweight_g, Shootweight_g, Nodule_LOBED, Nodule_UN_Lobed, Morphology)
### Find total nodule number
Host_data <- Host_data %>%
mutate(Nod_number = as.numeric(Nodule_LOBED) + as.numeric(Nodule_UN_Lobed),
Prop_branched = as.numeric(Nodule_LOBED)/Nod_number)
Host_data <- Host_data %>%
mutate(Variety = na_if(Variety, "")) %>%       # Converts "" to NA
mutate(Variety = na_if(Variety, " ")) %>%       # Converts " " to NA
filter(!is.na(Variety))
#View(Host_data)
## Now find the average per strain
Host_data_ave <-
Host_data %>%
group_by(Strain, Variety, Morphology) %>%
summarise(
ave_shoot = mean(as.numeric(Shootweight_g), na.rm = TRUE),
ave_root  = mean(as.numeric(Rootweight_g), na.rm = TRUE),
ave_nod_total = mean(Nod_number, na.rm = TRUE),
ave_prop_branched = mean(Prop_branched, na.rm = TRUE),
.groups = "drop"
)
Host_data_ave
#View(Host_data_ave)
### Now I will calculate the shoot biomass
### Figure: Host biomass ###
HostBiomass <- ggplot(data = Host_data_ave, aes(x= Morphology, y = ave_shoot, fill = Morphology)) +
stat_boxplot(geom = "errorbar", width = 0.3,position = position_dodge(width = 0.8)) +
geom_boxplot(outlier.shape = NA, position = position_dodge(width = 0.8)) +
stat_summary(fun = median, fun.min = median, fun.max = median,
geom = "crossbar", width = 0.6,
color = "black", linewidth = 0.4,
position = position_dodge(width = 0.8)) +
geom_quasirandom(size = 1.2, color = "black", width = 0.25, alpha = 0.8) +
scale_fill_manual(values = color_values) +
facet_wrap(~Variety) +
theme_classic() +
labs(
x= "Morphology",
y = "Plant shoot biomass (g)"
) +
theme(
text             = element_text(family = "Helvetica", color = "black"),
axis.text        = element_text(size = 14, color = "black"),
axis.title.x     = element_text(size = 18, color = "black"),
axis.title.y     = element_text(size = 18, color = "black"),
panel.grid       = element_blank(),
axis.line        = element_line(color = "black"),
axis.ticks       = element_line(color = "black"),
legend.position  = "none")
HostBiomass
ggsave(HostBiomass,
filename = here("Figures" ,"EPS_Figure4A_FromR.pdf"),
device = "pdf",
height = 4, width = 6, units = "in")
aov_hostbiomass <- aov(ave_shoot ~ Morphology*Variety, Host_data_ave)
summary(aov_hostbiomass)
anova_hostbiomass <- anova(aov_hostbiomass)
anova_hostbiomass
anova_hostbiomass <- rownames_to_column(as.data.frame(anova_hostbiomass), var = "Term") #For table formating
anova_hostbiomass
## Aesthetics
anova_hostbiomass <- anova_hostbiomass %>%
mutate(across(where(is.numeric) & !matches("^Df$"), ~ sprintf("%.3f", .))) %>%
mutate(`Pr(>F)` = ifelse(as.numeric(`Pr(>F)`) < 0.001, "< 0.001", `Pr(>F)`)) %>%
dplyr::select(-`Mean Sq`, P = `Pr(>F)`)
anova_hostbiomass
write_xlsx(anova_hostbiomass, here("Tables", "EPS_anova_hostbiomass_FromR.xlsx"))
#Freq_data <-  read.table(here("Data_input", "freq_100_AVT118.tsv"), header = TRUE, sep = "") #This is the frequency data
#Use what seems to be Sohini's updated data
Freq_data <-  read.table("https://raw.githubusercontent.com/sohini5981/AVT_SS/refs/heads/main/Data/freq_100_AVT118.tsv?token=GHSAT0AAAAAAEB5NZNJEBF6GQ3JD2MXEZ4Q2SZPACQ", header = TRUE, sep = "")
Freq_data <-  read.table("https://raw.githubusercontent.com/sohini5981/AVT_SS/refs/heads/main/Data/freq_100_AVT118.tsv?token=GHSAT0AAAAAAEB5NZNIRSIEOXQXTQKNXCUQ2S3Y5KQ", header = TRUE, sep = "")
Freq_data <-  read.table("https://raw.githubusercontent.com/sohini5981/AVT_SS/refs/heads/main/Data/freq_100_AVT118.tsv?token=GHSAT0AAAAAAEB5NZNIRSIEOXQXTQKNXCUQ2S3Y5KQ", header = TRUE, sep = "")
Freq_data <- Freq_data %>%
separate(col = pool,
into = c("AG", "Type", "Variety", "Rep"),
sep = "_",
remove = FALSE,
fill = "right"
)
#View(StrainFitness_data) I think the NA in Rep that don't have variety are probably the initial ones
Freq_data_MIX <- Freq_data %>% filter(Type == "MIX") ## Remove MC2
Freq_data_MIX <- Freq_data_MIX %>%
mutate(Variety = if_else(Variety %in% c("1", "2", "3", "4"), "Initial", Variety))
Initial_Freq_data_MIX <- Freq_data_MIX %>% filter(Variety == "Initial")
Initial_Freq_data_MIX
Freq_data_NoInitial <- Freq_data_MIX %>% filter(Variety != "Initial") ## In the dataframe the Rep that have NA don't have lsited the variety
Freq_data_NoInitial
Initial_Freq_data_MIX <-apply((Initial_Freq_data_MIX[,c(-1:-5)]), 2, mean) # The "2" specified that the mean should be found per column.
Initial_Freq_data_MIX
Freq_data_NoInitial
Sub_Freq <- Freq_data_NoInitial[, -c(1:5)]
Sub_Freq
normalized <- sweep(as.matrix(Sub_Freq), 2, Initial_Freq_data_MIX[colnames(Sub_Freq)], FUN = "/")
meso_fit <-as_tibble(cbind(Freq_data_NoInitial[,c(1:5)],log2(normalized))) #Find the log2 of the division and add back the information
meso_fit <- meso_fit %>%
mutate(across(where(is.numeric), ~ ifelse(. == -Inf, -8, .)))
meso_fit
meso_fit_long <- meso_fit %>%
pivot_longer(
cols = -c(Variety,Rep,pool, AG, Type, Variety, Rep),
names_to = "Strain_Code",
values_to = "Fitness"
)
StrainFitness_Plant <- merge(meso_fit_long, Strains, by = "Strain_Code")
meso_fit_ave <- StrainFitness_Plant %>%
group_by(Strain, Variety, Morphology) %>%
summarise(Fitness_ave = mean(Fitness))
View(meso_fit_ave)
meso_fit_ggplot <- ggplot(data = meso_fit_ave, aes(x= Morphology, y = Fitness_ave, fill = Morphology)) +
stat_boxplot(geom = "errorbar", width = 0.3,position = position_dodge(width = 0.8)) +
geom_boxplot(outlier.shape = NA, position = position_dodge(width = 0.8)) +
stat_summary(fun = median, fun.min = median, fun.max = median,
geom = "crossbar", width = 0.6,
color = "black", linewidth = 0.4,
position = position_dodge(width = 0.8)) +
geom_quasirandom(size = 1.2, color = "black", width = 0.25, alpha = 0.8) +
scale_fill_manual(values = color_values) +
facet_wrap(~Variety) +
theme_classic() +
labs(
x= "Morphology",
y = "Rhizobial relative fitness"
) +
theme(
text             = element_text(family = "Helvetica", color = "black"),
axis.text        = element_text(size = 14, color = "black"),
axis.title.x     = element_text(size = 18, color = "black"),
axis.title.y     = element_text(size = 18, color = "black"),
panel.grid       = element_blank(),
axis.line        = element_line(color = "black"),
axis.ticks       = element_line(color = "black"),
legend.position  = "none")
meso_fit_ggplot
ggsave(meso_fit_ggplot,
filename = here("Figures" ,"EPS_Figure4B_FromR.pdf"),
device = "pdf",
height = 4, width = 6, units = "in")
aov_RhizobialFitness <- lm(Fitness_ave ~ Morphology*Variety, meso_fit_ave)
summary(aov_RhizobialFitness)
anova_RhizobialFitness <- anova(aov_RhizobialFitness)
anova_RhizobialFitness
anova_RhizobialFitness <- rownames_to_column(as.data.frame(anova_RhizobialFitness), var = "Term") #For table formating
anova_RhizobialFitness
