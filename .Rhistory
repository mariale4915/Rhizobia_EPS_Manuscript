### Statistics
aov_Mixed_PercDry_Survival <- aov(Percentage_Dry_ave ~ Treatment*Timepoint, soil.expanded_ave %>%
filter(Condition == "Survival" & Population_Morphology == "Mixture")) ## In the ANOVA I am taking into account the timepoint 0
anova_Mixed_PercDry_Survival <- anova(aov_Mixed_PercDry_Survival) #Calculate the anova
anova_Mixed_PercDry_Survival <- rownames_to_column(as.data.frame(anova_Mixed_PercDry_Survival), var = "Term") #For table formating
anova_Mixed_PercDry_Survival
## Aesthetics
anova_Mixed_PercDry_Survival <- anova_Mixed_PercDry_Survival %>%
mutate(across(where(is.numeric) & !matches("^Df$"), ~ sprintf("%.3f", .))) %>%
mutate(`Pr(>F)` = ifelse(as.numeric(`Pr(>F)`) < 0.001, "< 0.001", `Pr(>F)`)) %>%
dplyr::select(-`Mean Sq`, P = `Pr(>F)`)
write_xlsx(anova_Mixed_PercDry_Survival, here("Tables", "EPS_anova_Mixed_PercDry_Survival_FromR.xlsx"))
## I will subset the each treatment and see what timepoints statistically have higher percentage of dry bacteria
### 32 C ###
aov_Mixed_PercDry_Survival_32C <- aov(Percentage_Dry_ave ~ Timepoint, soil.expanded_ave %>%
filter(Condition == "Survival" & Population_Morphology == "Mixture", Treatment == "32 °C"))
summary(aov_Mixed_PercDry_Survival_32C)
anova_Mixed_PercDry_Survival_32C <- anova(aov_Mixed_PercDry_Survival_32C)
anova_Mixed_PercDry_Survival_32C <- rownames_to_column(as.data.frame(anova_Mixed_PercDry_Survival_32C), var = "Term")
anova_Mixed_PercDry_Survival_32C
anova_Mixed_PercDry_Survival_32C <- anova_Mixed_PercDry_Survival_32C %>%
mutate(Treatment = "32 °C") %>%
mutate(across(where(is.numeric) & !matches("^Df$"), ~ sprintf("%.3f", .))) %>%
mutate(`Pr(>F)` = ifelse(as.numeric(`Pr(>F)`) < 0.001, "< 0.001", `Pr(>F)`)) %>%
dplyr::select(-`Mean Sq`, P = `Pr(>F)`)
#write_xlsx(anova_Mixed_PercDry_Survival_32C, here("Tables", "EPS_anova_anova_Mixed_PercDry_Survival_32C_FromR.xlsx"))
### Tukey test
Tukey_Mixed_PercDry_Survival_32C <- TukeyHSD(aov_Mixed_PercDry_Survival_32C)
Tukey_Mixed_PercDry_Survival_32C
Tukey_Mixed_PercDry_Survival_32C <- as.data.frame(Tukey_Mixed_PercDry_Survival_32C$`Timepoint`) %>%
rownames_to_column(var = "Comparison") %>%
mutate(across(where(is.numeric), ~ sprintf("%.3f", .))) %>%
mutate(Treatment = "32 °C") %>%
mutate(`p adj` = ifelse(as.numeric(`p adj`) < 0.001, "< 0.001", `p adj`)) %>%
dplyr::select(Treatment, Comparison, diff, P = `p adj`)
#write_xlsx(Tukey_Mixed_PercDry_Survival_32C, here("Tables", "EPS_Tukey_Mixed_PercDry_Survival_32C_FromR.xlsx"))
