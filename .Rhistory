#View(Shoot_fitness_OD_ave)
### Full linear model between Variety and Morphology. Dry and Mucoid morphology are analyzed here
aov_shoot <- lm(data = Shoot_fitness_OD_ave, ave_shoot ~ Variety*Morphology)
summary(aov_shoot)
anova_shoot <- anova(aov_shoot)
anova_shoot
aov_shoot_table <- rownames_to_column(as.data.frame(anova_shoot), var = "Term")
aov_shoot_table <- aov_shoot_table %>%
mutate(across(where(is.numeric) & !matches("^Df$"), ~ sprintf("%.3f", .))) %>%
mutate(`Pr(>F)` = ifelse(as.numeric(`Pr(>F)`) < 0.001, "< 0.001", `Pr(>F)`)) %>%
dplyr::select(-`Mean Sq`)
View(aov_shoot_table)
write_xlsx(aov_shoot_table, here("Tables", "aov_shoot_table_FromR.xlsx"))
## Subset per variety still analyzing the morphology Dry and mucoid
aov_shoot_O <- lm(data = Shoot_fitness_OD_ave %>% filter(Variety == "O"), ave_shoot ~ Morphology)
anova_shoot_O <- anova(aov_shoot_O)
aov_shoot_O_table <- rownames_to_column(as.data.frame(anova_shoot_O), var = "Term")
aov_shoot_O_table$Variety <- "Oneida"
aov_shoot_O_table
aov_shoot_S <- lm(data = Shoot_fitness_OD_ave %>% filter(Variety == "S"), ave_shoot ~ Morphology)
anova_shoot_S <- anova(aov_shoot_S)
aov_shoot_S_table <- rownames_to_column(as.data.frame(anova_shoot_S), var = "Term")
aov_shoot_S_table$Variety <- "S"
aov_shoot_S_table
aov_shoot_V <- lm(data = Shoot_fitness_OD_ave %>% filter(Variety == "V"), ave_shoot ~ Morphology)
anova_shoot_V <- anova(aov_shoot_V)
aov_shoot_V_table <- rownames_to_column(as.data.frame(anova_shoot_V), var = "Term")
aov_shoot_V_table$Variety <- "Vernal"
aov_shoot_V_table
aov_shoot_all_table <- rbind(aov_shoot_O_table, aov_shoot_S_table, aov_shoot_V_table)
aov_shoot_all_table <- aov_shoot_all_table %>%
select(Term, Variety, `Sum Sq`, `Mean Sq`, `F value`, `Pr(>F)`)
aov_shoot_all_table <- aov_shoot_all_table %>%
mutate(across(where(is.numeric) & !matches("^Df$"), ~ sprintf("%.3f", .))) %>%
mutate(`Pr(>F)` = ifelse(as.numeric(`Pr(>F)`) < 0.001, "< 0.001", `Pr(>F)`)) %>%
dplyr::select(-`Mean Sq`)
#View(aov_shoot_all_table)
write_xlsx(aov_shoot_all_table, here("Tables", "aov_shoot_all_table.xlsx"))
### I will make a linear model btween shoot biomass and Glucose calculated in anthrone assay
aov_shoot_GlucoseQuantity <- lm(data = Shoot_fitness_OD_ave, ave_shoot ~ Variety*Glucose_OD600_ave)
anova_shoot_GlucoseQuantity <- anova(aov_shoot_GlucoseQuantity)
anova_shoot_GlucoseQuantity
aov_shoot_table <- rownames_to_column(as.data.frame(anova_shoot_GlucoseQuantity), var = "Term")
aov_shoot_table <- aov_shoot_table %>%
mutate(across(where(is.numeric) & !matches("^Df$"), ~ sprintf("%.3f", .))) %>%
mutate(`Pr(>F)` = ifelse(as.numeric(`Pr(>F)`) < 0.001, "< 0.001", `Pr(>F)`)) %>%
dplyr::select(-`Mean Sq`)
#View(aov_shoot_table)
write_xlsx(aov_shoot_table, here("Tables", "aov_shoot_table_GlucoseQuantity.xlsx"))
### Similar analysis to see the slope
emm <- emtrends(aov_shoot_GlucoseQuantity, ~ Variety, var = "Glucose_OD600_ave")
