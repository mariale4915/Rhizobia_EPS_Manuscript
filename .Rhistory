###Maria here you need to organize in order the data for the times. It is not in order
Survival_DryPercentage <- ggplot(data = soil.expanded_ave %>%
filter(Condition == "Survival" & Population_Morphology == "Mixture" & Timepoint != "0") %>%
mutate(Timepoint = factor(Timepoint, levels = c("3 months", "6 months", "12 months"))),
aes(x = Treatment, y = Percentage_Dry_ave, fill = Treatment, group = interaction(Treatment, Timepoint))) +
stat_boxplot(geom = "errorbar", width = 0.3, color = "black", position = position_dodge(width = 0.8)) +
geom_boxplot(outlier.shape = NA, position = position_dodge(width = 0.8)) +
geom_jitter(aes(shape = Timepoint), position = position_jitterdodge(jitter.width = 0.15, dodge.width = 0.8), size = 2, color = "black") +
scale_shape_manual(values = myshapes_survival) +
scale_fill_manual(values = mycols) +
scale_y_continuous(limits = c(0, 100), breaks = seq(0, 100, 20), expand = c(0, 0)) +
geom_hline(yintercept= Initial_ave_growth, linetype="dashed", color="black", size=1) +
labs(x = "Treatment", y = "Percentage of Dry bacteria") +
theme_classic() +
theme(
text = element_text(family = "Helvetica", color = "black"),
axis.text = element_text(size = 14, color = "black"),
axis.title.x = element_text(size = 18),
axis.title.y = element_text(size = 18),
panel.grid = element_blank(),
axis.line = element_line(color = "black"),
axis.ticks = element_line(color = "black"),
legend.position = "none")
