Shift_Mucoid_Dry_Plant
## PLANT TRAITS
### Create the column nodule number, and from the single cell data I also have the CFU/area of nodule to determine the density of rhizobial released.
MasterSpreadsheet_AVT_Single_strain_exp <- read_excel("~/OneDrive - The Pennsylvania State University/Burghardt Lab Shared Folder/Projects/NIFA-AVT-AlfalfaProjects/Aim3AVT_SingleInoculationExp/_MasterSpreadsheet_AVT_Single_strain_exp.xlsx", sheet = 2)
MasterSpreadsheet_AVT_Single_strain_exp <- MasterSpreadsheet_AVT_Single_strain_exp %>%
filter(!is.na(Morphology)) %>% ##Filter out the mixtures and the strains that were not characterized (probably commercial inoculum)
mutate(Nod_number = as.numeric(Nodule_LOBED) + as.numeric(Nodule_UN_Lobed),
Prop_branched = as.numeric(Nodule_LOBED)/Nod_number)
MasterSpreadsheet_AVT_Single_strain_exp <- MasterSpreadsheet_AVT_Single_strain_exp %>%
select(c(Strain, Variety, Morphology, Shootweight_g, Rootweight_g, Nod_number, Prop_branched)) ## Remove traits not important for this analysis
MasterSpreadsheet_AVT_Single_strain_exp_ave <-
MasterSpreadsheet_AVT_Single_strain_exp %>%
group_by(Strain, Variety, Morphology) %>%
summarise(
ave_shoot = mean(as.numeric(Shootweight_g), na.rm = TRUE),
ave_root  = mean(as.numeric(Rootweight_g), na.rm = TRUE),
ave_nod_total = mean(Nod_number, na.rm = TRUE),
ave_prop_branched = mean(Prop_branched, na.rm = TRUE),
.groups = "drop"
)
## RHIZOBIA RELATIVE FITNESS
## I will import the file that Sohini sent me that has the information about the strains.
StrainFitness_Plants <- read.table("/Users/mariaalejandragilpolo/Downloads/Strain Fitness_AVTSS_pangenome.txt", header = TRUE, sep = "")
View(StrainFitness_Plants)
# This data set includes MC2 and also MIX. I think the one I need to use is MIX. Not MC2. I think MC2 has the extra commercial strains.
# I do not like the way the name of the strains are stored because it does not match the name I am giving htem so i will change that
StrainFitness_Plants <- StrainFitness_Plants %>%
separate(col = pool,
into = c("AG", "Type", "Variety", "Rep"), ## Type has MIX or MC2. I need to filter out MC2
sep = "_",
remove = FALSE,
fill = "right"
)
#View(StrainFitness_Plants)
## Filter out MC2 and only keep MIX values
StrainFitness_Plants <- StrainFitness_Plants %>% filter(Type == "MIX")
### I will shift this so that I have the colnames as rownames. I want a pivot longer
StrainFitness_Plants_long <- StrainFitness_Plants %>%
pivot_longer(
cols = -c(Variety,Rep,pool, AG, Type, Variety, Rep),
names_to = "Strain_Code",
values_to = "Fitness"
)
#View(StrainFitness_Plants_long)
Codes <- read_excel("/Users/mariaalejandragilpolo/Downloads/Strain_codes_Edited.xlsx")
#View(Codes)
### Now merge the files that they contain the same "Strain_Code"
StrainFitness_Plant <- merge(StrainFitness_Plants_long, Codes, by = "Strain_Code") ## This could be a Data_input for rhizobial fitness
write_xlsx(StrainFitness_Plant, here("Data_input", "Strain_fitness_Plant_FromR.xlsx")) ## This could be a Data_input for rhizobial with the raw MIX data for rhizobial fitness (Filtered out MC2 here for this table)
### Now I will make the like boxplots. Average and put it somewhere??
StrainFitness_Plant_ave <- StrainFitness_Plant %>%
group_by(Strain, Variety, Morphology) %>%
summarise(Fitness_ave = mean(Fitness))
write_xlsx(Strain_fitness_subset, here("Data_input", "Strain_fitness_Plant_FromR.xlsx"))
Anthrone_PlantBiomass_boxplots <- ggplot(data = MasterSpreadsheet_AVT_Single_strain_exp_ave, aes(x= Morphology, y = ave_shoot, fill = Morphology)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter() +
scale_fill_manual(values = color_initial_values) +
facet_wrap(~Variety) +
theme_classic() +
labs(
x= "Morphology",
y = "Plant shoot biomass (g)"
) +
theme(legend.position = "none")
Anthrone_PlantBiomass_boxplots
ggsave(here("Figures", "Morphology_Shoot_boxplots_FromR.pdf"), Anthrone_PlantBiomass_boxplots, width = 5, height = 3, units = "in")
### Full linear model between Variety and Morphology. Dry and Mucoid morphology are analyzed here
aov_shoot <- lm(data = Shoot_fitness_OD_ave, ave_shoot ~ Variety*Morphology)
summary(aov_shoot)
anova_shoot <- anova(aov_shoot)
anova_shoot
aov_shoot_table <- rownames_to_column(as.data.frame(anova_shoot), var = "Term")
aov_shoot_table <- aov_shoot_table %>%
mutate(across(where(is.numeric) & !matches("^Df$"), ~ sprintf("%.3f", .))) %>%
mutate(`Pr(>F)` = ifelse(as.numeric(`Pr(>F)`) < 0.001, "< 0.001", `Pr(>F)`)) %>%
dplyr::select(-`Mean Sq`)
View(aov_shoot_table)
write_xlsx(aov_shoot_table, here("Tables", "aov_shoot_table_FromR.xlsx"))
## Subset per variety still analyzing the morphology Dry and mucoid
aov_shoot_O <- lm(data = Shoot_fitness_OD_ave %>% filter(Variety == "O"), ave_shoot ~ Morphology)
anova_shoot_O <- anova(aov_shoot_O)
aov_shoot_O_table <- rownames_to_column(as.data.frame(anova_shoot_O), var = "Term")
aov_shoot_O_table$Variety <- "Oneida"
aov_shoot_O_table
aov_shoot_S <- lm(data = Shoot_fitness_OD_ave %>% filter(Variety == "S"), ave_shoot ~ Morphology)
anova_shoot_S <- anova(aov_shoot_S)
aov_shoot_S_table <- rownames_to_column(as.data.frame(anova_shoot_S), var = "Term")
aov_shoot_S_table$Variety <- "S"
aov_shoot_S_table
aov_shoot_V <- lm(data = Shoot_fitness_OD_ave %>% filter(Variety == "V"), ave_shoot ~ Morphology)
anova_shoot_V <- anova(aov_shoot_V)
aov_shoot_V_table <- rownames_to_column(as.data.frame(anova_shoot_V), var = "Term")
aov_shoot_V_table$Variety <- "Vernal"
aov_shoot_V_table
aov_shoot_all_table <- rbind(aov_shoot_O_table, aov_shoot_S_table, aov_shoot_V_table)
aov_shoot_all_table <- aov_shoot_all_table %>%
select(Term, Variety, `Sum Sq`, `Mean Sq`, `F value`, `Pr(>F)`)
aov_shoot_all_table <- aov_shoot_all_table %>%
mutate(across(where(is.numeric) & !matches("^Df$"), ~ sprintf("%.3f", .))) %>%
mutate(`Pr(>F)` = ifelse(as.numeric(`Pr(>F)`) < 0.001, "< 0.001", `Pr(>F)`)) %>%
dplyr::select(-`Mean Sq`)
#View(aov_shoot_all_table)
write_xlsx(aov_shoot_all_table, here("Tables", "aov_shoot_all_table.xlsx"))
## Merge shoot biomass and EPS production ##
#View(Anthrone_mean)
#View(MasterSpreadsheet_AVT_Single_strain_exp_ave)
#View(Anthrone_mean %>% select(-"Morphology"))
Shoot_OD_ave <- merge(MasterSpreadsheet_AVT_Single_strain_exp_ave, Anthrone_mean %>% select(-"Morphology"), by = "Strain")# Remove Morphology to avoid duplication of columns
#View(Shoot_OD_ave)
Shoot_OD_ave <- Shoot_OD_ave %>% select(Strain, Variety, Glucose_OD600_ave, ave_shoot, Morphology)
Shoot_OD_ave_NoOutliers <- Shoot_OD_ave %>% filter(!Strain %in% c("121", "018"))
View(Shoot_OD_ave_NoOutliers)
#View(Shoot_OD)
color_initial_values <- c("Dry" = "#e0ba3e",
"Mucoid" = "#4eadb9")
### Shoot biomass jitter
Anthrone_PlantBiomass <- ggplot(data = Shoot_OD_ave_NoOutliers, aes(x= Glucose_OD600_ave, y = ave_shoot, color = Morphology)) +
geom_jitter() +
geom_smooth(method = "lm",
se = FALSE,
color = "grey") +
scale_color_manual(values = color_initial_values) +
facet_wrap(~Variety) +
theme_classic() +
labs(
x= "Glucose/OD600",
y = "Plant shoot biomass (g)"
)
Anthrone_PlantBiomass
ggsave("Anthrone_PlantBiomass_FromR_nooutlier.pdf", Anthrone_PlantBiomass, width = 9, height = 4, units = "in")
### I will make a linear model between shoot biomass and Glucose calculated in anthrone assay
aov_shoot_GlucoseQuantity <- lm(data = Shoot_fitness_OD_ave, ave_shoot ~ Variety*Glucose_OD600_ave)
anova_shoot_GlucoseQuantity <- anova(aov_shoot_GlucoseQuantity)
anova_shoot_GlucoseQuantity
aov_shoot_table <- rownames_to_column(as.data.frame(anova_shoot_GlucoseQuantity), var = "Term")
aov_shoot_table <- aov_shoot_table %>%
mutate(across(where(is.numeric) & !matches("^Df$"), ~ sprintf("%.3f", .))) %>%
mutate(`Pr(>F)` = ifelse(as.numeric(`Pr(>F)`) < 0.001, "< 0.001", `Pr(>F)`)) %>%
dplyr::select(-`Mean Sq`)
#View(aov_shoot_table)
write_xlsx(aov_shoot_table, here("Tables", "aov_shoot_table_GlucoseQuantity.xlsx"))
### Similar analysis to see the slope
emm <- emtrends(aov_shoot_GlucoseQuantity, ~ Variety, var = "Glucose_OD600_ave")
emm
pairs(emm, adjust = "holm") #The slopes are positive for S and O but it is negative for V.
test(emm)
