summary(aov_hostbiomass)
anova_aov_hostBranching <- car::Anova(aov_hostBranching, type = "II")
anova_aov_hostBranching <- rownames_to_column(as.data.frame(anova_aov_hostBranching), var = "Term")
anova_aov_hostBranching
anova_aov_hostBranching <- anova_aov_hostBranching %>%
mutate(across(where(is.numeric) & !matches("^Df$"), ~ sprintf("%.3f", .))) %>%
mutate(`Pr(>F)` = ifelse(as.numeric(`Pr(>F)`) < 0.001, "< 0.001", `Pr(>F)`))
anova_aov_hostBranching
write_xlsx(anova_aov_hostBranching, here("Phenotype", "Tables", "EPS_TableS10C_FromR.xlsx"))
