write_xlsx(aov_fitness_table, here("Tables", "aov_shoot_table_GlucoseQuantity.xlsx"))
### Evaluate the slopes
emm <- emtrends(aov_fitness_GlucoseQuantity, ~ Variety, var = "Glucose_OD600_ave")
emm
pairs(emm, adjust = "holm") #The slopes are positive for S and O but it is negative for V.
test(emm)
### None of the slopes crosses "0" for either the lower.CL, and the upper.CL.
## Subset per variety
aov_fitness_O <- lm(data = Shoot_fitness_OD_ave_NoOutliers %>% filter(Variety == "O"), Fitness_ave ~ Glucose_OD600_ave)
aov_fitness_O
anova_fitness_O <- anova(aov_fitness_O)
aov_fitness_O_table <- rownames_to_column(as.data.frame(anova_fitness_O), var = "Term")
aov_fitness_O_table$Variety = "Oneida"
aov_fitness_S <- lm(data = Shoot_fitness_OD_ave_NoOutliers %>% filter(Variety == "S"), Fitness_ave ~ Glucose_OD600_ave)
aov_fitness_S
anova_fitness_S <- anova(aov_fitness_S)
aov_fitness_S_table <- rownames_to_column(as.data.frame(anova_fitness_S), var = "Term")
aov_fitness_S_table$Variety = "S"
aov_fitness_V <- lm(data = Shoot_fitness_OD_ave_NoOutliers %>% filter(Variety == "V"), Fitness_ave ~ Glucose_OD600_ave)
aov_fitness_V
anova_fitness_V <- anova(aov_fitness_V)
aov_fitness_V_table <- rownames_to_column(as.data.frame(anova_fitness_V), var = "Term")
aov_fitness_V_table$Variety = "Vernal"
aov_fitness_all_table <- rbind(aov_fitness_O_table, aov_fitness_S_table, aov_fitness_V_table)
aov_fitness_all_table <- aov_fitness_all_table %>%
select(Term, Variety, `Sum Sq`, `Mean Sq`, `F value`, `Pr(>F)`)
aov_shoot_all_GlucoseQuantity_table <- aov_fitness_all_table %>%
mutate(across(where(is.numeric) & !matches("^Df$"), ~ sprintf("%.3f", .))) %>%
mutate(`Pr(>F)` = ifelse(as.numeric(`Pr(>F)`) < 0.001, "< 0.001", `Pr(>F)`)) %>%
dplyr::select(-`Mean Sq`)
#View(aov_shoot_all_table)
write_xlsx(aov_shoot_all_GlucoseQuantity_table, here("Tables", "aov_fitness_all_table_GlucoseQuantity.xlsx"))
