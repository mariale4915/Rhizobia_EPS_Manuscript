### I have a total of 19 pairs in this particular isolation and I want to know if the classified as "dry" has less EPS than the classified as "mucoid"
## Pairs
Strains_used <- read_excel("~/OneDrive - The Pennsylvania State University/Burghardt Lab Shared Folder/Projects/NIFA-AVT-AlfalfaProjects/Aim1bAVT_StrainCollection/Chapter1_Partners_Mariale/Analysis/Strains_used_EPS.xlsx", sheet = 1)
## I will subset the ones that have a pair
Strain_used_pair <- Strains_used %>% filter(!is.na(Pairs))
Strain_used_pair <- Strain_used_pair %>%
mutate(Pair_strain = paste0(Pairs, "_", Strain))
Pair_Anthrone_complete <- left_join(Strain_used_pair, Anthrone_complete, by = "Strain")
#View(Pair_Anthrone)
color_initial_values <- c("Dry" = "#e0ba3e",
"Mucoid" = "#4eadb9")
Pairs_anthrone <- ggplot(Pair_Anthrone_complete, aes(x = Pairs, y = Glucose_OD600, colour = Morphology_initial)) +
geom_jitter() +
geom_line() +
scale_color_manual(values = color_initial_values) +
theme_minimal() +
coord_flip()
Pairs_anthrone
ggsave(Pairs_anthrone, file = here("Figures/FigureSB.pdf"), width = 10, height = 10, units = "in")
## Statistics
model1_raw <- lmer(Glucose_OD600 ~ Morphology + (1|Pairs),
data = Pair_Anthrone_complete) # Linear mixed model is better than a two way anova because Pair and morphology are not independent from one another.
anova1 <- anova(model1_raw)
anova1
anova1 <- rownames_to_column(as.data.frame(anova1), var = "Term")
anova1
colnames(anova1)
anova_TableS1 <- anova1 %>%
mutate(across(where(is.numeric) & !matches("^Df$"), ~ sprintf("%.3f", .))) %>%
mutate(`Pr(>F)` = ifelse(as.numeric(`Pr(>F)`) < 0.001, "< 0.001", `Pr(>F)`)) %>%
dplyr::select(-`Mean Sq`, - NumDF, - DenDF)
anova_TableS1
write_xlsx(anova_TableS1, "TableS1_FromR.xlsx")
## EPS DRY AND MUCOID _INITIAL
Pair_Anthrone_mean <- left_join(Strain_used_pair, Anthrone_mean, by = "Strain")
unique(Pair_Anthrone_mean$Morphology_further)
Dry_Mucoid_initial_distribution <- ggplot(Pair_Anthrone_mean, aes(x = Glucose_OD600_ave, y = Morphology_initial)) +
geom_density_ridges(aes(fill = Morphology_initial)) +
scale_fill_manual(values = color_initial_values) +
labs(title = "Initial classification of Dry and Mucoid bacteria", x = "Glucose/OD600", y = "Initial assigned morphology") +
theme_classic()
Dry_Mucoid_initial_distribution
ggsave(Dry_Mucoid_initial_distribution, file = here("Figures/Dry_Mucoid_initial_distribution.pdf"), width = 10, height = 5, units = "in")
aov2 <- aov(data = Pair_Anthrone_mean, Glucose_OD600_ave ~ Morphology_initial)
anova2 <- anova(aov2)
anova2
anova2 <- rownames_to_column(as.data.frame(anova2), var = "Term")
anova_TableS5 <- anova2 %>%
mutate(across(where(is.numeric) & !matches("^Df$"), ~ sprintf("%.3f", .))) %>%
mutate(`Pr(>F)` = ifelse(as.numeric(`Pr(>F)`) < 0.001, "< 0.001", `Pr(>F)`)) %>%
dplyr::select(-`Mean Sq`)
write_xlsx(anova_TableS5, "TableS5_FromR.xlsx")
