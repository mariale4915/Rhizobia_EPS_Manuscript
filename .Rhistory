#### Compile the Tukey tests ####
Tukey_Growth_soil <- bind_rows(Tukey_Mixed_PercDry_Growth_22C, Tukey_Mixed_PercDry_Growth_32C,Tukey_Mixed_PercDry_Growth_DroughtC)
Tukey_Growth_soil
Tukey_wide_Growth_soil <- Tukey_Growth_soil %>%
pivot_wider(
names_from = Treatment,
values_from = c(diff, P)
)
Tukey_wide_Growth_soil <- Tukey_wide_Growth_soil %>% select(Comparison, `diff_22 °C`, `P_22 °C`, `diff_32 °C`, `P_32 °C`, diff_Drought, P_Drought)
Tukey_wide_Growth_soil
