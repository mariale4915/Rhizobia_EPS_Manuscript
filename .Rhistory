### Density of reproducible bacteria per nodule (CFU/area)
## This requires a different document
# We crushed individual nodules and performed dilution series and plated them in culture media to estimate
Single_nodule_CFU <-  read.csv(here("Data_input", "Host_Single_Nodule_CFU.csv"))
#View(Single_nodule_CFU)
Single_nodule_CFU <- Single_nodule_CFU %>%
separate_wider_delim(
cols = Sample_ID,
delim = ".",
names = c("Strain", "Variety", "Plant_Rep"),
too_few = "align_start"
)
Single_nodule_CFU
Single_nodule_CFU <- Single_nodule_CFU %>%
mutate(spot.1 = as.numeric(spot.1),
spot.2 = as.numeric(spot.2),
spot.3 = as.numeric(spot.3),
spot.4 = as.numeric(spot.4),
spot.5 = as.numeric(spot.5)
)
Single_nodule_CFU <- Single_nodule_CFU %>% filter(Variety %in% c("O", "V", "S"))
Single_nodule_CFU <- Single_nodule_CFU %>%
mutate(spot_ave = rowMeans(across(c(spot.1, spot.2, spot.3, spot.4, spot.5)), na.rm = TRUE))
Single_nodule_CFU
### I will calculate the total CFU
Single_nodule_CFU <- Single_nodule_CFU %>%
mutate(Total_CFU = spot_ave*(10^(dilution.counted - 1))*1000/20)
#View(Single_nodule_CFU)
Single_nodule_CFU <- Single_nodule_CFU %>%
mutate(Density = Total_CFU/`Nodule.area`)
Single_nodule_CFU
Single_nodule_CFU_clean <- Single_nodule_CFU %>%
filter(is.finite(Density), Density > 0)## There are some Nan in density because some nodules did not have countable colonies or contamination, and it could also be NA because we did not take the nodule area for some nodules. There are also some 0 because all the CFU we counted were 0, I also need to get rid of that.
Density <- ggplot(data = Single_nodule_CFU, aes(x= Morphology, y = log10(Density), fill = Morphology)) +
stat_boxplot(geom = "errorbar", width = 0.3,position = position_dodge(width = 0.8)) +
geom_boxplot(outlier.shape = NA, position = position_dodge(width = 0.8)) +
stat_summary(fun = median, fun.min = median, fun.max = median,
geom = "crossbar", width = 0.6,
color = "black", linewidth = 0.4,
position = position_dodge(width = 0.8)) +
geom_quasirandom(size = 1.2, color = "black", width = 0.25, alpha = 0.8) +
scale_fill_manual(values = color_values) +
facet_wrap(~Variety) +
theme_classic() +
labs(
x= "Morphology",
y = "Log10(CFU/area per nodule)"
) +
theme(
text             = element_text(family = "Helvetica", color = "black"),
axis.text        = element_text(size = 10, color = "black"),
axis.title.x     = element_text(size = 12, color = "black"),
axis.title.y     = element_text(size = 12, color = "black"),
panel.grid       = element_blank(),
axis.line        = element_line(color = "black"),
axis.ticks       = element_line(color = "black"),
legend.position  = "none")
Density
#View(Single_nodule_CFU)
ggsave(Density,
filename = here("Figures" ,"EPS_Density_FromR.pdf"),
device = "pdf",
height = 3, width = 4, units = "in")
### Before running the code:
